#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Test framework for imap-shim.

Runs the shim as a subprocess, then exercises IMAP commands against it via
aioimaplib (async) and raw sockets (blocking, in a thread).
"""

import sys
import os
sys.path.append(os.path.join(sys.path[0], 'lib'))

import argparse
import asyncio
import json
import re
import socket
import subprocess
import time

import aioimaplib
import n5core.endpoint
from n5core.endpoint import HTTPError, LoginFailure

shim_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'imap-shim')


class ImapTestResult:
    def __init__(self):
        self.passed = 0
        self.failed = 0
        self.errors = []

    def add_pass(self, name):
        self.passed += 1
        print(f"  PASS: {name}")

    def add_fail(self, name, msg=""):
        self.failed += 1
        detail = f"  FAIL: {name}"
        if msg:
            detail += f" — {msg}"
        print(detail)
        self.errors.append((name, msg))


class ImapTestSuite:
    def __init__(self, baseurl='http://localhost:8092/noark5v5/',
                 username='admin@example.com', password='password', shim_port=143):
        self.baseurl = baseurl
        self.username = username
        self.password = password
        self.shim_port = shim_port
        self.result = ImapTestResult()
        self.server_proc = None
        self.imap = None

    async def start_shim(self):
        """Start imap-shim as a subprocess."""
        cmd = [sys.executable, shim_path, '--baseurl', self.baseurl, '--port', str(self.shim_port)]
        print(f"Starting shim: {' '.join(cmd)}")
        self.server_proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True
        )
        # Wait for the server to be ready (port open)
        for i in range(30):
            try:
                r, w = await asyncio.open_connection('127.0.0.1', self.shim_port)
                w.close()
                await w.wait_closed()
                break
            except OSError:
                await asyncio.sleep(0.2)
        else:
            raise RuntimeError("Shim did not start in time")
        print(f"Shim running on port {self.shim_port}")

    async def stop_shim(self):
        """Stop the shim subprocess."""
        if self.server_proc:
            self.server_proc.terminate()
            try:
                await asyncio.sleep(0.5)
                self.server_proc.kill()
            except ProcessLookupError:
                pass
            self.server_proc.wait()

    def connect(self):
        """Connect to the IMAP shim (blocking constructor, async greeting)."""
        self.imap = aioimaplib.IMAP4(host='127.0.0.1', port=self.shim_port)

    async def wait_greeting(self):
        """Wait for server greeting."""
        resp = await self.imap.wait_hello_from_server()
        print(f"  Server: {resp}")
        return resp

    # ---- Test cases (aioimaplib, async) ----

    async def test_capability(self):
        async def _():
            resp, data = await self.imap.noop()
            print(f"  NOOP response: {resp} — {data}")
            self.result.add_pass("connection established")

        await _()

    async def test_login_ok(self):
        async def _():
            resp, data = await self.imap.login(self.username, self.password)
            assert resp == 'OK', f"Expected OK, got {resp} — {data}"
            self.result.add_pass(f"LOGIN with valid credentials")

        await _()

    async def test_list(self):
        async def _():
            resp, data = await self.imap.list('""', '%')
            assert resp == 'OK', f"Expected OK from LIST, got {resp} — {data}"
            if isinstance(data, list):
                entries = [line.decode('utf-8', errors='replace') for line in data]
            else:
                entries = [data.decode('utf-8', errors='replace')]
            print(f"  LIST returned {len(entries)} mailboxes")
            for e in entries[:5]:
                print(f"    {e}")
            self.result.add_pass("LIST returns mailboxes")

        await _()

    async def test_select_first(self):
        """SELECT the first mailbox from LIST."""
        async def _():
            resp, data = await self.imap.list('""', '%')
            assert resp == 'OK', f"LIST failed: {resp}"
            if isinstance(data, list) and len(data) > 0:
                raw = data[0].decode('utf-8', errors='replace')
                m = re.match(r'.*"([^"]*)"', raw)
                if m:
                    mailbox = m.group(1)
                else:
                    self.result.add_fail("SELECT", f"can't parse mailbox name from '{raw}'")
                    return
            else:
                self.result.add_fail("SELECT", "no mailboxes from LIST")
                return

            resp, data = await self.imap.select(mailbox)
            assert resp == 'OK', f"Expected OK from SELECT '{mailbox}', got {resp} — {data}"
            print(f"  SELECT '{mailbox}' returned: {data}")
            self.result.add_pass(f"SELECT '{mailbox}'")

        await _()

    async def test_select_with_messages(self):
        """SELECT an archive with messages and verify EXISTS count."""
        async def _():
            resp, data = await self.imap.list('""', '%')
            assert resp == 'OK', f"LIST failed: {resp}"

            target_mailbox = None
            if isinstance(data, list):
                for entry in data:
                    raw = entry.decode('utf-8', errors='replace')
                    # Prefer Testarkiv (has imported emails)
                    m = re.match(r'.*"([^"]*)"', raw)
                    if m and 'Testarkiv' in m.group(1):
                        target_mailbox = m.group(1)
                        break

            if not target_mailbox:
                # Fallback to first mailbox
                for entry in data[:]:
                    raw = entry.decode('utf-8', errors='replace')
                    m = re.match(r'.*"([^"]*)"', raw)
                    if m:
                        target_mailbox = m.group(1)
                        break

            if not target_mailbox:
                self.result.add_fail("SELECT messages", "no mailboxes")
                return

            resp, data = await self.imap.select(target_mailbox)
            assert resp == 'OK', f"SELECT failed: {resp} — {data}"
            print(f"  SELECT '{target_mailbox}' response: {data}")
            if data and hasattr(data, '__len__'):
                exists_count = 0
                for d in data:
                    dl = d.decode('utf-8', errors='replace') if isinstance(d, bytes) else str(d)
                    m2 = re.match(r'(\d+) EXISTS', dl.strip())
                    if m2:
                        exists_count = int(m2.group(1))
                print(f"  Messages found: {exists_count}")
                self.result.add_pass(f"SELECT '{target_mailbox}' ({exists_count} messages)")

        await _()

    async def test_fetch_uid(self):
        """FETCH UID for selected message."""
        async def _():
            resp, data = await self.imap.uid('fetch', '1', '(UID)')
            assert resp == 'OK', f"UID FETCH failed: {resp} — {data}"
            if data:
                raw = b''.join(data) if isinstance(data, list) else data
                print(f"  UID FETCH response: {raw[:200]}")
                # Verify it contains a UUID-like UID
                uid_text = raw.decode('utf-8', errors='replace')
                has_uuid = len([c for c in uid_text if c == '-']) >= 4 or len(uid_text) > 10
                assert has_uuid, f"No valid UID found in response: {uid_text}"
            self.result.add_pass("FETCH UID")

        await _()

    async def test_fetch_uid_flags(self):
        """FETCH UID + FLAGS (metadata only, no literal body)."""
        async def _():
            resp, data = await self.imap.fetch('1', '(UID FLAGS INTERNALDATE RFC822.SIZE)')
            assert resp == 'OK', f"FETCH metadata failed: {resp} — {data}"
            if data:
                raw = b''.join(data) if isinstance(data, list) else data
                text = raw.decode('utf-8', errors='replace')
                print(f"  FETCH metadata: {text[:150]}")
            self.result.add_pass("FETCH UID FLAGS INTERNALDATE RFC822.SIZE")

        await _()

    async def test_logout(self):
        async def _():
            resp, data = await self.imap.logout()
            assert resp in ('OK', 'BYE'), f"Expected OK or BYE from LOGOUT, got {resp}"
            self.result.add_pass("LOGOUT")

        await _()

    # ---- Raw socket tests (blocking, run via asyncio.to_thread) ----

    def _raw_socket_tests(self):
        """Raw socket IMAP test mimicking Mutt's exact protocol format.

        Run as blocking code — called from async context via asyncio.to_thread.
        aioimaplib alone cannot catch real-client protocol differences (e.g.
        Mutt sends "user" "pass" vs aioimaplib's user "pass")."""
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.connect(('127.0.0.1', self.shim_port))
        time.sleep(0.5)

        def recv(timeout=3):
            data = b''
            deadline = time.time() + timeout
            while time.time() < deadline:
                try:
                    s.settimeout(min(0.2, max(0.1, deadline - time.time())))
                    chunk = s.recv(8192)
                    if not chunk: break
                    data += chunk
                except socket.timeout:
                    pass
                except ConnectionResetError:
                    break
            return data.decode(errors='replace')

        def send(cmd):
            s.send((cmd + '\r\n').encode())

        # Drain greeting
        recv(0.5)

        # Test 1: Login (Mutt style — both credentials quoted)
        send(f'a001 LOGIN "{self.username}" "{self.password}"')
        resp = recv(5)
        if 'a001 OK' in resp:
            self.result.add_pass("raw socket LOGIN")
        else:
            self.result.add_fail("raw socket LOGIN", resp.strip()[:80])

        # Test 2: SELECT with UIDVALIDITY and UIDNEXT
        send('a002 SELECT "Testarkiv"')
        resp = recv(10)
        m = re.search(r'(\d+) EXISTS', resp)
        msg_count = int(m.group(1)) if m else 0

        if not m:
            self.result.add_fail("raw socket SELECT", "no EXISTS response")
        elif '[UIDVALIDITY' not in resp:
            self.result.add_fail("raw socket SELECT", f"{msg_count} msgs but missing [UIDVALIDITY]")
        elif '[UIDNEXT' not in resp:
            self.result.add_fail("raw socket SELECT", f"{msg_count} msgs but missing [UIDNEXT]")
        else:
            self.result.add_pass(f"raw socket SELECT ({msg_count} msgs with UIDVALIDITY+UIDNEXT)")

        # Test 3: FETCH HEADER.FIELDS (Mutt sends without outer quotes on items list)
        send('a003 FETCH 1 (UID FLAGS BODY.PEEK[HEADER.FIELDS (FROM SUBJECT DATE)])')
        resp = recv(5)
        fetches = [l for l in resp.split('\r\n') if 'FETCH' in l and l.strip().startswith('*')]
        has_hf = any('BODY[HEADER.FIELDS' in l for l in fetches)

        if not fetches:
            self.result.add_fail("raw FETCH HEADER.FIELDS", "no FETCH responses")
        elif not has_hf:
            self.result.add_fail("raw FETCH HEADER.FIELDS", f"{len(fetches)} msgs but no BODY[HEADER.FIELDS] data")
        else:
            self.result.add_pass(f"raw FETCH HEADER.FIELDS ({len(fetches)} msgs with header data)")

        # Test 4: UID FETCH (Mutt-style quoted items)
        send('a004 UID FETCH 1 ("UID FLAGS INTERNALDATE RFC822.SIZE")')
        resp = recv(3)
        fetches = [l for l in resp.split('\r\n') if 'FETCH' in l and l.strip().startswith('*')]
        has_uid = any('UID' in l for l in fetches)
        has_id = any('INTERNALDATE' in l for l in fetches)

        if not fetches:
            self.result.add_fail("raw UID FETCH", "no FETCH responses")
        elif not (has_uid and has_id):
            sample = fetches[0][:120] if fetches else 'empty'
            self.result.add_fail("raw UID FETCH", f"missing fields. Got: {sample}")
        else:
            self.result.add_pass(f"raw UID FETCH ({len(fetches)} msgs with all fields)")

        # Test 4b: Full BODY[] (Mutt sends this when opening a message)
        send('a004b UID FETCH 1 BODY.PEEK[]')
        resp = recv(8)
        body_match = re.search(r'BODY\[\]\s*\{(\d+)\}', resp)
        if not body_match:
            self.result.add_fail("raw UID FETCH BODY[]", "no literal body in response")
        else:
            body_size = int(body_match.group(1))
            # Verify the response contains actual email content (not just metadata)
            has_email_content = 'From:' in resp or 'Subject:' in resp or 'Date:' in resp
            if not has_email_content:
                self.result.add_fail("raw UID FETCH BODY[]", f"literal {body_size} bytes but no email headers")
            else:
                self.result.add_pass(f"raw UID FETCH BODY[] ({body_size} bytes with email content)")

        # Test 5: Range FETCH (Mutt sends 1:N for index display)
        send('a005 FETCH 1:3 (UID FLAGS BODY.PEEK[HEADER.FIELDS (FROM SUBJECT)])')
        resp = recv(8)
        fetches = [l for l in resp.split('\r\n') if 'FETCH' in l and l.strip().startswith('*')]

        if len(fetches) < 3:
            self.result.add_fail("raw range FETCH", f"expected 3 msgs, got {len(fetches)}")
        elif not any('HEADER.FIELDS' in l for l in fetches):
            self.result.add_fail("raw range FETCH", "range returned but no HEADER data")
        else:
            self.result.add_pass(f"raw range FETCH ({len(fetches)} msgs with headers)")

        send('a006 LOGOUT')
        recv(1)
        s.close()

    # ---- Main test runs ----

    async def run_basic(self):
        """Run basic connectivity tests."""
        print("\n=== Basic IMAP Tests ===\n")

        self.connect()
        try:
            await self.wait_greeting()
            await self.test_capability()
            await self.test_login_ok()
            await self.test_list()
            await self.test_select_with_messages()
            await self.test_fetch_uid()
            await self.test_fetch_uid_flags()
            await self.test_logout()
        except Exception as e:
            print(f"  ERROR during basic tests: {e}")
            import traceback
            traceback.print_exc()

    async def run_reject(self):
        """Test login rejection (needs fresh connection)."""
        print("\n=== Login Rejection Test ===\n")

        self.connect()
        try:
            await self.wait_greeting()
            resp, data = await self.imap.login('baduser', 'badpass')
            assert resp == b'NO', f"Expected NO for bad login, got {resp}"
            self.result.add_pass("LOGIN rejected with bad credentials")
        except Exception as e:
            # Current shim closes connection on bad login — expected for now
            print(f"  INFO: Connection closed on bad login (expected): {e}")
            self.result.add_pass("LOGIN rejection (connection closed)")

    async def run_raw(self):
        """Run raw socket tests (Mutt compatibility) in a blocking thread."""
        print("\n=== Raw Socket Tests (Mutt compatibility) ===\n")
        await asyncio.to_thread(self._raw_socket_tests)

    async def run_full(self):
        """Run all tests."""
        await self.run_basic()
        await self.run_reject()
        await self.run_raw()


async def main():
    parser = argparse.ArgumentParser(description='Test framework for imap-shim')
    parser.add_argument('--baseurl', default='http://localhost:8092/noark5v5/',
                        help="Noark 5 API base URL (default: %(default)s)")
    parser.add_argument('--username', default='admin@example.com', help="API username")
    parser.add_argument('--password', default='password', help="API password")
    parser.add_argument('--port', type=int, default=143, help="IMAP shim port")
    args = parser.parse_args()

    suite = ImapTestSuite(
        baseurl=args.baseurl,
        username=args.username,
        password=args.password,
        shim_port=args.port
    )

    await suite.start_shim()
    try:
        await suite.run_full()
    finally:
        await suite.stop_shim()

    print(f"\n=== Results: {suite.result.passed} passed, {suite.result.failed} failed ===")
    if suite.result.errors:
        for name, msg in suite.result.errors:
            print(f"  FAIL: {name}: {msg}")
    sys.exit(1 if suite.result.failed else 0)


asyncio.run(main())
